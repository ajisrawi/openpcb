(pcb demo
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad OpenBoard) (host_version 0.1))
  (resolution um 1)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)) (direct horizontal))
    (layer B.Cu (type signal) (property (index 1)) (direct vertical))
    (boundary (path pcb 0 0 0 70000 0 70000 50000 0 50000 0 0))
    (via Via[0-1]_800:400_um)
    (rule (width 250) (clearance 200))
  )
  (placement
    (component QFP-32 (place U1 30000 25000 front 0 (PN MCU)))
    (component SOIC-8 (place U2 54000 36000 front 90 (PN EEPROM)))
    (component SOT-23 (place Q1 54000 14000 front 0 (PN NPN)))
    (component R_0603
      (place R1 12000 42000 front 0 (PN 10k))
      (place R2 12000 38000 front 0 (PN 10k))
      (place R3 46000 8000 front 90 (PN 1k))
      (place R4 40000 44000 front 0 (PN 4k7))
      (place R5 48000 44000 front 0 (PN 4k7))
    )
    (component C_0402
      (place C1 18000 30000 front 90 (PN 100n))
      (place C2 42000 30000 front 90 (PN 100n))
      (place C3 18000 18000 front 90 (PN 100n))
      (place C4 42000 18000 front 90 (PN 100n))
    )
    (component Header_1x6 (place J1 6000 24000 front 90 (PN ISP)))
    (component Header_1x4 (place J2 64000 24000 front 90 (PN I2C)))
  )
  (library
    (image QFP-32
      (outline (path signal 0 -3500 -3500 3500 -3500 3500 3500 -3500 3500 -3500 -3500))
      (pin Rect[T]Pad_1500x450_um 1 -4050 -2800)
      (pin Rect[T]Pad_1500x450_um 2 -4050 -2000)
      (pin Rect[T]Pad_1500x450_um 3 -4050 -1200)
      (pin Rect[T]Pad_1500x450_um 4 -4050 -400)
      (pin Rect[T]Pad_1500x450_um 5 -4050 400)
      (pin Rect[T]Pad_1500x450_um 6 -4050 1200)
      (pin Rect[T]Pad_1500x450_um 7 -4050 2000)
      (pin Rect[T]Pad_1500x450_um 8 -4050 2800)
      (pin Rect[T]Pad_450x1500_um 9 -2800 4050)
      (pin Rect[T]Pad_450x1500_um 10 -2000 4050)
      (pin Rect[T]Pad_450x1500_um 11 -1200 4050)
      (pin Rect[T]Pad_450x1500_um 12 -400 4050)
      (pin Rect[T]Pad_450x1500_um 13 400 4050)
      (pin Rect[T]Pad_450x1500_um 14 1200 4050)
      (pin Rect[T]Pad_450x1500_um 15 2000 4050)
      (pin Rect[T]Pad_450x1500_um 16 2800 4050)
      (pin Rect[T]Pad_1500x450_um 17 4050 2800)
      (pin Rect[T]Pad_1500x450_um 18 4050 2000)
      (pin Rect[T]Pad_1500x450_um 19 4050 1200)
      (pin Rect[T]Pad_1500x450_um 20 4050 400)
      (pin Rect[T]Pad_1500x450_um 21 4050 -400)
      (pin Rect[T]Pad_1500x450_um 22 4050 -1200)
      (pin Rect[T]Pad_1500x450_um 23 4050 -2000)
      (pin Rect[T]Pad_1500x450_um 24 4050 -2800)
      (pin Rect[T]Pad_450x1500_um 25 2800 -4050)
      (pin Rect[T]Pad_450x1500_um 26 2000 -4050)
      (pin Rect[T]Pad_450x1500_um 27 1200 -4050)
      (pin Rect[T]Pad_450x1500_um 28 400 -4050)
      (pin Rect[T]Pad_450x1500_um 29 -400 -4050)
      (pin Rect[T]Pad_450x1500_um 30 -1200 -4050)
      (pin Rect[T]Pad_450x1500_um 31 -2000 -4050)
      (pin Rect[T]Pad_450x1500_um 32 -2800 -4050)
    )
    (image SOIC-8
      (outline (path signal 0 -2790 -1600 2790 -1600 2790 1600 -2790 1600 -2790 -1600))
      (pin Rect[T]Pad_600x1800_um 1 -1905 2700)
      (pin Rect[T]Pad_600x1800_um 2 -635 2700)
      (pin Rect[T]Pad_600x1800_um 3 635 2700)
      (pin Rect[T]Pad_600x1800_um 4 1905 2700)
      (pin Rect[T]Pad_600x1800_um 5 1905 -2700)
      (pin Rect[T]Pad_600x1800_um 6 635 -2700)
      (pin Rect[T]Pad_600x1800_um 7 -635 -2700)
      (pin Rect[T]Pad_600x1800_um 8 -1905 -2700)
    )
    (image SOT-23
      (outline (path signal 0 -1500 -700 1500 -700 1500 700 -1500 700 -1500 -700))
      (pin Rect[T]Pad_800x900_um 1 -950 1100)
      (pin Rect[T]Pad_800x900_um 2 950 1100)
      (pin Rect[T]Pad_800x900_um 3 0 -1100)
    )
    (image R_0603
      (outline (path signal 0 -1300 -650 1300 -650 1300 650 -1300 650 -1300 -650))
      (pin Rect[T]Pad_900x1000_um 1 -800 0)
      (pin Rect[T]Pad_900x1000_um 2 800 0)
    )
    (image C_0402
      (outline (path signal 0 -800 -450 800 -450 800 450 -800 450 -800 -450))
      (pin Rect[T]Pad_600x700_um 1 -500 0)
      (pin Rect[T]Pad_600x700_um 2 500 0)
    )
    (image Header_1x6
      (outline (path signal 0 -1270 -7620 1270 -7620 1270 7620 -1270 7620 -1270 -7620))
      (pin Rect[A]Pad_1700x1700_um 1 0 -6350)
      (pin Round[A]Pad_1700_um 2 0 -3810)
      (pin Round[A]Pad_1700_um 3 0 -1270)
      (pin Round[A]Pad_1700_um 4 0 1270)
      (pin Round[A]Pad_1700_um 5 0 3810)
      (pin Round[A]Pad_1700_um 6 0 6350)
    )
    (image Header_1x4
      (outline (path signal 0 -1270 -5080 1270 -5080 1270 5080 -1270 5080 -1270 -5080))
      (pin Rect[A]Pad_1700x1700_um 1 0 -3810)
      (pin Round[A]Pad_1700_um 2 0 -1270)
      (pin Round[A]Pad_1700_um 3 0 1270)
      (pin Round[A]Pad_1700_um 4 0 3810)
    )
    (padstack Via[0-1]_800:400_um (shape (circle F.Cu 800)) (shape (circle B.Cu 800)) (attach off))
    (padstack Rect[T]Pad_1500x450_um (shape (rect F.Cu -750 -225 750 225)))
    (padstack Rect[T]Pad_450x1500_um (shape (rect F.Cu -225 -750 225 750)))
    (padstack Rect[T]Pad_600x1800_um (shape (rect F.Cu -300 -900 300 900)))
    (padstack Rect[T]Pad_800x900_um (shape (rect F.Cu -400 -450 400 450)))
    (padstack Rect[T]Pad_900x1000_um (shape (rect F.Cu -450 -500 450 500)))
    (padstack Rect[T]Pad_600x700_um (shape (rect F.Cu -300 -350 300 350)))
    (padstack Rect[A]Pad_1700x1700_um (shape (rect F.Cu -850 -850 850 850)) (shape (rect B.Cu -850 -850 850 850)))
    (padstack Round[A]Pad_1700_um (shape (circle F.Cu 1700)) (shape (circle B.Cu 1700)))
  )
  (network
    (net VCC (pins U1-5 U1-21 C1-1 C2-1 C3-1 C4-1 J1-2 J2-1 U2-8 R1-1 R2-1 R4-1 R5-1))
    (net GND (pins U1-6 U1-22 C1-2 C2-2 C3-2 C4-2 J1-6 J2-4 U2-4 Q1-2))
    (net SDA (pins U1-12 U2-5 J2-2 R4-2))
    (net SCL (pins U1-13 U2-6 J2-3 R5-2))
    (net MOSI (pins U1-15 J1-4))
    (net MISO (pins U1-16 J1-1))
    (net SCK (pins U1-17 J1-3))
    (net RESET (pins U1-29 J1-5 R1-2))
    (net LED (pins U1-2 R3-1))
    (net BASE (pins R3-2 Q1-1))
    (net OUT (pins Q1-3 U1-25))
    (net PULL (pins R2-2 U1-30))
    (net INT (pins U1-8 U2-7))
    (net WP (pins U1-9 U2-3))
  )
)
